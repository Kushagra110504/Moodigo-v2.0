# Required: Groq API key (FREE - no credit card needed)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Optional: Model selection (defaults to openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# Optional: Restrict CORS to a specific origin (defaults to *)
# ALLOWED_ORIGIN=https://yourdomain.com
